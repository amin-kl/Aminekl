# ── انسخ هذا الملف إلى .env وعدّل القيم ──────────────────────

# توكن بوت Telegram الثاني (اصنعه عبر @BotFather)
BOT2_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# chat_id المالك — يستقبل كل الصور والنتائج
# اعرفه عبر @userinfobot
BOT2_OWNER=987654321

# Container Image URL الافتراضي (اختياري — يمكن تركه فارغاً)
# إذا تركته فارغاً سيطلبه البوت من المستخدم في كل مرة
CONTAINER_URL=docker.io/username/image:latest
